---
import { getCollection } from 'astro:content';
import { Link } from 'accessible-astro-components';

const base = import.meta.env.BASE_URL;
const levels = await getCollection('levels');
---

<em>Note: This is a work-in-progress project. See <Link href="http://github.com/doctor-g/game-design-concepts/">the project site</Link>.</em>

<h1>Contents</h1>
<ul>
  {
    levels.map(level => (
      <li>
        <Link href={base + "/" + level.id}>Level {level.data.number}: {level.data.name}</Link>
      </li>
    ))
  }
</ul>

<style>
/* Expands the clickable area for easy mobile tapping */
li a {
  display: block;
  padding: 12px 16px;
}
</style>