---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Link } from 'accessible-astro-components';

export async function getStaticPaths() {
  const levels = await getCollection('levels');
  return levels.map(level => ({
    params: { level: level.id },
    props: { level },
  }));
}

const { level } = Astro.props;
const { Content } = await render(level);
---
<Layout title=`Level ${level.data.number}: ${level.data.name}`>
<div class="level-content">
<Content/>
</div>
<footer>
<hr/>
<p>
  This level of Game Design Concepts by Ian Schreiber was originally published at <Link href={level.data.originalUrl}>{level.data.originalUrl}</Link> and is presented here under the terms of <Link href="http://creativecommons.org/licenses/by/3.0/us/">Creative Commons Attribution 3.0 United States License</Link>.
</p>
</footer>
</Layout>

<style>
  .level-content :global(:is(img[src*="green-circle"], img[src*="blue-square"], img[src*="black-diamond"])) {
    float: left;
    margin: 0.2rem 0.75rem 0.5rem 0;
  }

  .level-content :global(p:has(> :is(img[src*="green-circle"], img[src*="blue-square"], img[src*="black-diamond"]))) {
    display: flow-root;
  }
</style>